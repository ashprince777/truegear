datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         String        @default("BUYER") // BUYER, DEALER, ADMIN
  phone        String?
  avatar       String?
  dealerName   String?
  dealerRating Float?        @default(4.8)
  dealerCity   String?
  dealerState  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  listings      Listing[]
  savedSearches SavedSearch[]
  favorites     Favorite[]
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
}

model Listing {
  id            String         @id @default(cuid())
  sellerId      String
  seller        User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  make          String
  model         String
  year          Int
  trim          String?
  bodyType      String         // Sedan, SUV, Truck, Coupe, Convertible, Hatchback, Wagon, Van
  mileage       Int
  price         Float
  vin           String         @unique
  description   String
  location      String?        // e.g. "Dallas, TX"
  city          String
  state         String
  zip           String
  lat           Float          @default(37.7749)
  lng           Float          @default(-122.4194)
  fuelType      String         @default("Gasoline") // Gasoline, Hybrid, Electric, Diesel
  transmission  String         @default("Automatic") // Automatic, Manual
  drivetrain    String         @default("FWD") // FWD, RWD, AWD, 4WD
  exteriorColor String?
  interiorColor String?
  condition     String         @default("Used") // New, Used, Certified Pre-Owned
  status        String         @default("ACTIVE") // ACTIVE, PENDING, SOLD, FLAGGED
  engine        String?
  features      String?        // JSON string array of features
  accidents     Int            @default(0)
  previousOwners Int           @default(1)
  serviceHistory Int           @default(12)
  views         Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  images        ListingImage[]
  favorites     Favorite[]
  messages      Message[]
  inquiries     InquiryLead[]
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  order     Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SavedSearch {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  filtersJson String   // Serialized JSON filters
  createdAt   DateTime @default(now())
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

model Message {
  id         String   @id @default(cuid())
  fromUserId String
  fromUser   User     @relation("SentMessages", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User     @relation("ReceivedMessages", fields: [toUserId], references: [id], onDelete: Cascade)
  listingId  String?
  listing    Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  body       String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model InquiryLead {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerName  String
  buyerEmail String
  buyerPhone String?
  message    String
  status     String   @default("NEW") // NEW, CONTACTED, CLOSED
  createdAt  DateTime @default(now())
}
